# Dockerfile for the ASIC ERS pilot API only (backend/pilot_api.py).
# Deliberately separate from Dockerfile.backend (the existing
# bill-smoothing product) -- different service, different database,
# different deployment lifecycle.

FROM python:3.12-slim

# Tesseract OCR is a system dependency, not a pip package -- required
# by backend/bill_ocr.py. See that module's docstring.
RUN apt-get update && apt-get install -y --no-install-recommends \
    tesseract-ocr \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY backend/requirements-pilot-api.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt --timeout 120

COPY backend/ /app/

EXPOSE 8000

# Render (and most PaaS hosts) inject $PORT at runtime -- fall back to
# 8000 for local/Docker Compose use.
CMD ["sh", "-c", "uvicorn pilot_api:app --host 0.0.0.0 --port ${PORT:-8000}"]
